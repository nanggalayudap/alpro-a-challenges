total_pendapatan = 0
jumlah_transaksi = 7
i = 1

while i <= jumlah_transaksi:
    print(f"\nTransaksi ke-{i}")
    harga = int(input("Masukkan harga barang: "))
    jumlah = int(input("Masukkan jumlah barang: "))

    subtotal = harga * jumlah
    total_pendapatan = total_pendapatan + subtotal

    if subtotal >= 200000:
        kategori = "Penjualan Besar"
    elif subtotal >= 100000:
        kategori = "Penjualan Sedang"
    elif subtotal >= 50000:
        kategori = "Penjualan Kecil"
    else:
        kategori = "Penjualan Rendah"

    print(f"Kategori: {kategori}")
    print(f"Subtotal: Rp{subtotal}")
    i = i + 1

rata_rata = total_pendapatan / jumlah_transaksi

print("\n--- Rekap Penjualan ---")
print(f"Total Pendapatan: Rp{total_pendapatan}")
print(f"Rata-rata Pendapatan: Rp{rata_rata}")

